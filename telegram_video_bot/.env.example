# Telegram bot token from @BotFather. Keep the value private.
BOT_TOKEN=

# Comma-separated numeric Telegram user IDs; admins receive notifications.
ADMIN_IDS=

# Supabase project URL and service_role key (server-side secret only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Monitoring interval in seconds (minimum 60).
POLL_INTERVAL_SECONDS=900

# Number of recent videos checked per profile (1-50).
MAX_VIDEOS_PER_PROFILE=20
